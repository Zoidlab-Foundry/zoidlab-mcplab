# --- ZoidLab MCPLab (Foundry Package 12) ---
# Shared ZoidLab SSO secret — MUST match the other *.zoidlab.ai apps.
BUILDER_SESSION_SECRET=change-me

# Backend
DATA_DIR=./backend/data
PORT=8706
DATABASE_URL=postgresql://app_rls@127.0.0.1:5433/mcplab
DATABASE_URL_ADMIN=postgresql://foundry@127.0.0.1:5433/mcplab
MCPLAB_ADMINS=

# Foundry Pro gate
FOUNDRY_GATE_ENABLED=true
FOUNDRY_REQUIRED_PLAN=pro
MOCK_PRO_USER=false
PRO_TIERS=pro,teams

# Relay (for REAL MCP discovery+test) — reuse the shared Nyquest relay key
NYQUEST_BASE_URL=https://api.nyquest.ai/v1
NYQUEST_API_KEY=

# Cross-app enforcement (SpendGuard usage + TrustGate preflight)
FOUNDRY_INTEGRATION=on
SPENDGUARD_URL=http://127.0.0.1:8701
TRUSTGATE_URL=http://127.0.0.1:8700

# Durable jobs (Celery worker)
REDIS_URL=redis://127.0.0.1:6380/0

# Frontend
MCPLAB_API_URL=http://127.0.0.1:8706
NYQUEST_API=https://api.nyquest.ai
NYQUEST_APP_ORIGIN=https://app.nyquest.ai
SESSION_COOKIE_DOMAIN=.zoidlab.ai
